---
layout: null
---
[
{%- for post in site.posts -%}
	{%- assign text = post.content | strip_html | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'" | replace: '&amp;', '&' -%}
	{
		"u": {{ post.url | relative_url | jsonify }},
		"t": {{ post.title | jsonify }},
		"c": {{ text | jsonify }}
	}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
